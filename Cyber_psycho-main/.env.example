# =====================================================================
# ChronoZero — Exploit Defect Lab + Obsidian Knowledge Vault
# Every service here is 100% FREE. Nothing below requires payment.
# =====================================================================

# GEMINI_API_KEY: Optional free tier Google Gemini API key (generativelanguage.googleapis.com).
# If omitted, ChronoZero seamlessly runs on the 100% free built-in autonomous heuristic engine!
GEMINI_API_KEY="AIzaSyYourFreeKeyHere"

# GROQ_API_KEY: Optional free fast inference API key (console.groq.com — free tier).
GROQ_API_KEY="gsk_your_free_key_here"

# MONGODB_URI: Optional free MongoDB Atlas M0 cluster connection string.
# If omitted or offline, ChronoZero persists everything to data/*.json on this laptop.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/chronozero?retryWrites=true&w=majority"

# GEMINI_MODEL: which Gemini model the AI proxy calls (optional).
#GEMINI_MODEL="gemini-3.8-flash"

# ---------------------------------------------------------------------
# OBSIDIAN KNOWLEDGE VAULT (the permanent memory system)
# OBSIDIAN_VAULT_PATH: leave EMPTY to get the first-launch setup screen.
# Paste any absolute Windows folder path there, e.g.
#   D:\AI-Research\ChronoZero-Vault
# The path you choose in the Knowledge Vault tab is saved here automatically.
# Environment variables like %USERNAME% are expanded.
# ---------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=""
OBSIDIAN_AUTO_SAVE="true"
OBSIDIAN_AUTO_LINK="true"
OBSIDIAN_MEMORY_ENABLED="true"
VAULT_WRITE_PROTECT="true"
VAULT_WEB_SEARCH_ENABLED="true"

# PORT: Server port (defaults to 3000)
PORT=3000

# HOST: Network interface to bind.
# 127.0.0.1 = this PC only (more private — recommended for a laptop)
# 0.0.0.0   = also reachable from other devices on your home Wi-Fi
HOST="127.0.0.1"

# AUTO_OPEN_BROWSER: automatically open your default browser the moment the
# server is live. start.bat / start.ps1 enable this for you.
AUTO_OPEN_BROWSER="true"

# VITE_API_URL (advanced): only needed if you ever host the frontend and the
# backend on DIFFERENT origins. Leave empty when running on the laptop.
#VITE_API_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
