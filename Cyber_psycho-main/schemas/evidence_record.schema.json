{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronozero.ai/schemas/evidence_record.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "tool",
    "target",
    "environment",
    "outputs",
    "result",
    "reproducibility",
    "integrity"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-\\d{8}-\\d{4}$",
      "description": "Unique evidence identifier"
    },
    "tool": {
      "type": "object",
      "required": ["name", "tier", "argv"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "grep", "ripgrep", "semgrep", "codeql", "slither", "echidna",
            "foundry", "afl", "libfuzzer", "zzuf", "radamsa", "dredd",
            "z3", "cvc5", "klee", "angr", "manticore", "maat", "truffle",
            "hardhat", "forge", "anvil", "ganache", "manticore", "crowbar",
            "securify", "mythril", "solhint", "solc", "surya", "hevm",
            "evmfuzz", "ityfuzz"
          ]
        },
        "tier": { "type": "integer", "minimum": 1, "maximum": 6 },
        "argv": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["commit", "fingerprint", "in_scope_authorization"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "in_scope_authorization": { "type": "string", "enum": ["none", "self", "org", "public"] }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["network", "sandbox_id", "image_digest"],
      "properties": {
        "network": { "type": "string", "enum": ["none", "loopback", "egress"] },
        "sandbox_id": { "type": "string" },
        "image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["exit_code", "stdout_sha256", "artifact_ref"],
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "artifact_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["verdict", "findings"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "fail", "crash", "timeout", "inconclusive"] },
        "findings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": ["reruns", "identical", "seed"],
      "properties": {
        "reruns": { "type": "integer", "minimum": 1 },
        "identical": { "type": "integer", "minimum": 0 },
        "seed": { "type": "string" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["record_sha256", "prev_record_sha256"],
      "properties": {
        "record_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "prev_record_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tool": { "properties": { "tier": { "minimum": 3 } } } },
      "then": { "properties": { "target": { "properties": { "in_scope_authorization": { "not": { "const": "none" } } } } }
    },
    {
      "if": { "properties": { "tool": { "properties": { "tier": { "minimum": 4 } } } },
      "then": {
        "properties": {
          "environment": { "properties": { "network": { "enum": ["none", "loopback"] } } },
          "target": {
            "properties": {
              "commit": { "type": "string" },
              "fingerprint": { "type": "string" },
              "in_scope_authorization": { "not": { "const": "none" } }
            },
            "required": ["commit", "fingerprint", "in_scope_authorization"]
          }
        }
      }
    }
  ]
}