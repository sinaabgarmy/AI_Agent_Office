{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronozero.ai/schemas/envelope.schema.json",
  "title": "Message Bus Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_meta",
    "payload"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic sequence number per session; M5_SEQ_REGRESSION rejects regressions"
    },
    "session_id": {
      "type": "string",
      "description": "Debate session the envelope belongs to"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical payload; M1_PAYLOAD_TAMPERED recomputes it"
    },
    "turn_meta": {
      "type": "object",
      "required": ["armed", "tier_max", "tool_calls", "memory_injected", "blind_round"],
      "properties": {
        "armed": { "type": "boolean", "description": "Recomputed by the bus, never accepted from the agent" },
        "tier_max": { "type": "integer", "minimum": 1, "maximum": 6 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "memory_injected": { "type": "boolean" },
        "blind_round": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "type": "string", "enum": ["claim", "evidence", "prediction", "skill", "query"] },
        "content": {}
      },
      "additionalProperties": false
    }
  }
}
